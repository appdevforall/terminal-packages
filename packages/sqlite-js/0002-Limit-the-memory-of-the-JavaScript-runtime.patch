diff --git a/README.md b/README.md
index 45bf583..52efd7b 100644
--- a/README.md
+++ b/README.md
@@ -410,6 +410,15 @@ Configures the maximum stack size (in bytes) for the JavaScript engine.
 SELECT js_set_max_stack_size(1048576);  -- Set max stack size to 1 MB
 ```
 
+### js_set_memory_limit
+
+Sets the most memory, in bytes, that JavaScript may allocate on this connection; 0 means no limit. The default is 64 MB (64 × 1024 × 1024 bytes); build with `-DSQLITE_JS_DEFAULT_MEMORY_LIMIT=bytes` to change it. Code that needs more fails with an "out of memory" error, and the connection stays usable.
+
+```sql
+SELECT js_set_memory_limit(268435456);  -- Allow 256 MB
+SELECT js_set_memory_limit(0);          -- No limit
+```
+
 ### Interrupting JavaScript
 
 JavaScript runs inside the SQL statement that calls it, so `sqlite3_interrupt()` stops it as it stops any statement: the statement fails with an "interrupted" error, even if the code catches exceptions. In the `sqlite3` shell, Ctrl-C does this. Interrupting JavaScript needs SQLite 3.41.0 or later.
diff --git a/src/sqlitejs.c b/src/sqlitejs.c
index 524581e..558744f 100644
--- a/src/sqlitejs.c
+++ b/src/sqlitejs.c
@@ -187,6 +187,14 @@ static void js_rowset_finalizer(JSRuntime *rt, JSValue val) {
 
 // MARK: - Initializer -
 
+// The most memory, in bytes, the JavaScript runtime of a connection may allocate until
+// js_set_memory_limit() changes it; 0 means no limit. Without a limit, code that keeps
+// allocating takes all the memory of the process, which on a phone ends with the operating
+// system killing it. 64 MB is room for over a thousand aggregate contexts (about 54 KB each).
+#ifndef SQLITE_JS_DEFAULT_MEMORY_LIMIT
+#define SQLITE_JS_DEFAULT_MEMORY_LIMIT  (64 * 1024 * 1024)
+#endif
+
 // QuickJS calls this from time to time while it runs code. A non-zero result stops the code
 // with an uncatchable "interrupted" error, so sqlite3_interrupt() (Ctrl-C in the sqlite3 shell,
 // a cancelled query in an app) also stops JavaScript that never returns to SQLite.
@@ -207,7 +215,7 @@ static globaljs_context *globaljs_init (sqlite3 *db) {
     rt = JS_NewRuntime();
     if (!rt) goto abort_init;
     
-    //JS_SetMemoryLimit(rt, 80 * 1024);
+    JS_SetMemoryLimit(rt, SQLITE_JS_DEFAULT_MEMORY_LIMIT);
     //JS_SetMaxStackSize(rt, 10 * 1024);
 
     // sqlite3_is_interrupted() is new in SQLite 3.41.0: an older library has no such entry
@@ -1305,6 +1313,20 @@ void js_set_max_stack_size (sqlite3_context *context, int argc, sqlite3_value **
     JS_SetMaxStackSize(js->runtime, stack_size);
 }
 
+void js_set_memory_limit (sqlite3_context *context, int argc, sqlite3_value **argv) {
+    UNUSED(argc);
+    globaljs_context *js = (globaljs_context *)sqlite3_user_data(context);
+
+    if ((sqlite3_value_type(argv[0]) != SQLITE_INTEGER) || (sqlite3_value_int64(argv[0]) < 0)) {
+        sqlite3_result_error(context, "The memory limit must be an integer number of bytes, or 0 for no limit", -1);
+        return;
+    }
+
+    // a limit beyond the address space (on a 32-bit system) can never be reached, so it is no limit
+    sqlite3_uint64 limit = (sqlite3_uint64)sqlite3_value_int64(argv[0]);
+    JS_SetMemoryLimit(js->runtime, (limit > SIZE_MAX) ? 0 : (size_t)limit);
+}
