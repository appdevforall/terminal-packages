diff --git a/README.md b/README.md
index ff51b2f..99abfb9 100644
--- a/README.md
+++ b/README.md
@@ -176,6 +176,19 @@ SQLite-JS provides several ways to extend SQLite functionality with JavaScript:
 | Collation Sequences | Define custom sort orders for text values |
 | JavaScript Evaluation | Directly evaluate JavaScript code within SQLite |
 
+### Values
+
+SQL values reach JavaScript as follows:
+
+| SQL | JavaScript |
+|-----|------------|
+| NULL | `null` |
+| INTEGER, REAL | number |
+| TEXT | string |
+| BLOB | `ArrayBuffer` |
+
+A JavaScript result goes back to SQL as follows: `null` and `undefined` become NULL, a boolean an INTEGER (1 or 0), a number an INTEGER if it is a whole number in the 32-bit range and a REAL otherwise, a BigInt an INTEGER, a string TEXT, and an `ArrayBuffer` or a typed array such as `Uint8Array` a BLOB. Other objects become NULL; return `JSON.stringify(value)` to keep one as TEXT. The parameters of `db.exec()` convert the same way.
+
 ## Scalar Functions
 
 Scalar functions process one row at a time and return a single value. They are useful for data transformation, calculations, text manipulation, etc.
diff --git a/src/sqlitejs.c b/src/sqlitejs.c
index 5765567..2c11877 100644
--- a/src/sqlitejs.c
+++ b/src/sqlitejs.c
@@ -366,6 +366,38 @@ static void functionjs_free (functionjs_context *fctx) {
 
 // MARK: - Utils -
 
+// Gets the bytes of an ArrayBuffer, or of the part of an ArrayBuffer that a typed array such
+// as a Uint8Array views: the forms a BLOB takes in JavaScript (a BLOB arrives as an
+// ArrayBuffer). Returns 1 and sets *pbytes and *psize if value is one of them (*pbytes may be
+// NULL when *psize is 0), 0 if it is not, and -1 with a pending JavaScript exception if its
+// buffer is detached or the typed array is out of its bounds.
+static int js_get_bytes (JSContext *ctx, JSValueConst value, const uint8_t **pbytes, size_t *psize) {
+    *pbytes = NULL;
+    *psize = 0;
+
+    if (JS_IsArrayBuffer(value)) {
+        uint8_t *buf = JS_GetArrayBuffer(ctx, psize, value);
+        if (!buf && JS_HasException(ctx)) return -1;
+        *pbytes = buf;
+        return 1;
+    }
+
+    if (JS_GetTypedArrayType(value) >= 0) {
+        size_t offset = 0, length = 0, size = 0;
+        JSValue buffer = JS_GetTypedArrayBuffer(ctx, value, &offset, &length, NULL);
+        if (JS_IsException(buffer)) return -1;
+        uint8_t *buf = JS_GetArrayBuffer(ctx, &size, buffer);
+        // the typed array keeps its buffer alive, so buf stays valid
+        JS_FreeValue(ctx, buffer);
+        if (!buf && JS_HasException(ctx)) return -1;
+        *pbytes = (buf) ? buf + offset : NULL;
+        *psize = length;
+        return 1;
+    }
+
+    return 0;
+}
+
 static int js_bind_value (JSContext *ctx, sqlite3_stmt *vm, int index, JSValueConst val) {
     if (JS_IsNull(val) || JS_IsUndefined(val)) {
         return sqlite3_bind_null(vm, index);
@@ -400,14 +432,18 @@ static int js_bind_value (JSContext *ctx, sqlite3_stmt *vm, int index, JSValueCo
         JS_FreeCString(ctx, str);
         return rc;
     }
-    if (JS_IsArrayBuffer(val)) {
-        size_t size = 0;
-        uint8_t *buf = JS_GetArrayBuffer(ctx, &size, val);
-        if (buf) {
-            return sqlite3_bind_blob(vm, index, buf, (int)size, SQLITE_TRANSIENT);
-        }
+    const uint8_t *bytes = NULL;
+    size_t size = 0;
+    int is_blob = js_get_bytes(ctx, val, &bytes, &size);
+    if (is_blob < 0) {
+        // a detached buffer has no bytes to bind, so it binds NULL
+        JS_FreeValue(ctx, JS_GetException(ctx));
         return sqlite3_bind_null(vm, index);
     }
+    if (is_blob) {
+        if (size == 0) return sqlite3_bind_zeroblob(vm, index, 0);
+        return sqlite3_bind_blob64(vm, index, bytes, (sqlite3_uint64)size, SQLITE_TRANSIENT);
+    }
     return sqlite3_bind_null(vm, index);
 }
 
@@ -636,11 +672,25 @@ static void js_value_to_sqlite (sqlite3_context *context, JSContext *js_ctx, JSV
         return;
     }
     
+    // handle ArrayBuffer and typed arrays, the forms a BLOB takes in JavaScript
+    const uint8_t *bytes = NULL;
+    size_t size = 0;
+    int is_blob = js_get_bytes(js_ctx, value, &bytes, &size);
+    if (is_blob < 0) {
+        js_error_to_sqlite(context, js_ctx, JS_EXCEPTION, NULL);
+        return;
+    }
+    if (is_blob) {
+        if (size == 0) sqlite3_result_zeroblob(context, 0);
+        else sqlite3_result_blob64(context, bytes, (sqlite3_uint64)size, SQLITE_TRANSIENT);
+        return;
+    }
+
     if (JS_IsObject(value)) {
         sqlite3_result_null(context);
         return;
     }
-    
+
     // fallback for unsupported types
     sqlite3_result_error(context, "Unsupported JS value type", -1);
 }
